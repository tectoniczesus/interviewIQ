# =========================================
# Secrets — never commit real credentials
# =========================================
.env
.env.local
.env.*.local
backend/.env
frontend/.env
# .env.example files ARE meant to be committed (templates, no real values)

# application.yml has real API keys hardcoded directly in it (personal
# preference, not the .env-based setup the rest of this project assumes)
backend/src/main/resources/application.yml

# =========================================
# Backend — Java / Maven
# =========================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# =========================================
# Frontend — Node / Vite
# =========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# =========================================
# IDE / editor
# =========================================
.idea/
*.iml
*.iws
.vscode/
!.vscode/extensions.json
.vs/

# =========================================
# OS cruft
# =========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# =========================================
# Logs
# =========================================
*.log
logs/

# =========================================
# Misc
# =========================================
*.tmp
*.bak
.cache/