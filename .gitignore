# =========================================
# Secrets — never commit real credentials
# =========================================
.env
.env.local
.env.*.local
backend/.env
frontend/.env
# .env.example files are ignored on purpose: the local copies have held real
# values. Variable names are documented in README.md section 3 instead.
.env.example

# application.yml holds only ${NAME} placeholders now; real values live in
# backend/.env. Still ignored so nobody pastes a key back into it.
backend/src/main/resources/application.yml

# =========================================
# AI / design tooling output
# =========================================
.agents/
.claude/
.playwright-mcp/
.impeccable/
frontend/.taste-skill/
skills-lock.json

# =========================================
# Backend — Java / Maven
# =========================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# =========================================
# Frontend — Node / Vite
# =========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# =========================================
# IDE / editor
# =========================================
.idea/
*.iml
*.iws
.vscode/
!.vscode/extensions.json
.vs/

# =========================================
# OS cruft
# =========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# =========================================
# Logs
# =========================================
*.log
logs/

# =========================================
# Misc
# =========================================
*.tmp
*.bak
.cache/